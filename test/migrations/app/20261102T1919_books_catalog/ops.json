  {
    "id": "unique.Category.Category_name_key",
    "label": "Add unique constraint on \"Category\" (name)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Category_name_key",
        "table": "Category"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Category_name_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Category_name_key",
          "public",
          "\"public\".\"Category\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "constraint \"Category_name_key\" on \"Category\""
        }
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Category_name_key\"",
        "sql": "ALTER TABLE \"public\".\"Category\" ADD CONSTRAINT \"Category_name_key\" UNIQUE (\"name\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify unique constraint \"Category_name_key\" exists on (name)",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3) AND \"c\".\"contype\" = $4 AND (SELECT coalesce(jsonb_agg(key_attribute.attname ORDER BY key_column.position), '[]'::jsonb) FROM unnest(\"c\".\"conkey\"::int2[]) WITH ORDINALITY AS key_column(attnum, position) JOIN pg_attribute key_attribute ON key_attribute.attrelid = \"c\".\"conrelid\" AND key_attribute.attnum = key_column.attnum) = ($5)::jsonb)) AS \"result\"",
        "params": [
          "Category_name_key",
          "public",
          "\"public\".\"Category\"",
          "u",
          "[\"name\"]"
        ]
      }
    ]
  }
